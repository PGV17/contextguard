# ContextGuard configuration. Copy to .env and adjust.
# All environment variables use the CG_ prefix.

# --- Application ---
CG_ENVIRONMENT=development
CG_LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CG_SECRET_KEY=contextguard-development-secret-key-change-me

# --- Database ---
CG_DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/rag_db

# --- Production embeddings + generation (OpenAI) ---
CG_EMBEDDING_PROVIDER=openai
CG_EMBEDDING_MODEL=text-embedding-3-small
CG_EMBEDDING_DIMENSIONS=1536
CG_LLM_PROVIDER=openai
CG_LLM_MODEL=gpt-4o-mini
CG_OPENAI_API_KEY=

# --- Offline alternative (no API key, install the local extra) ---
# pip install -e ".[local]"
# CG_EMBEDDING_PROVIDER=local
# CG_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CG_EMBEDDING_DIMENSIONS=384
# CG_LLM_PROVIDER=extractive

# --- Retrieval ---
CG_RETRIEVAL_TOP_K=5
CG_RETRIEVAL_MAX_TOP_K=20
CG_RETRIEVAL_MIN_SIMILARITY=0.65
CG_PUBLIC_DEPARTMENT=All
CG_HNSW_EF_SEARCH=100

# --- Ingestion ---
CG_CHUNK_SIZE=1000
CG_CHUNK_OVERLAP=150
CG_MIN_INGEST_CLEARANCE=2
